	)
	(text_box "DESIGN NOTES:\nVref = 1V (0.92-1.08)\nIf PR1 > Vref -> Vin1\nIf PR1 < Vref -> Vin2\n\nSo VinCritical = (R1+R2)/(R2)*Vref = 4.2V"
		(exclude_from_sim no)
		(at 170.688 61.722 0)
		(size 50.165 19.685)
		(margins 1.6335 1.6335 1.6335 1.6335)
