	(text_box "DESIGN NOTES:\nRoute D+ and D- as 90 ohmes differential pair. And match the length."
		(exclude_from_sim no)
		(at 13.716 13.208 0)
		(size 89.535 10.414)
		(margins 1.8 1.8 1.8 1.8)
		(stroke
			(width 0.6)
			(type solid)
			(color 132 132 132 1)
		)
		(fill
