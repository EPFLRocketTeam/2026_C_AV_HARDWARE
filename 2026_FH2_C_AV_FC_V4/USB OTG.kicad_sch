			)
			(justify left top)
		)
		(uuid "3a146387-9f9b-4859-93c1-5046fd1fb832")
	)
	(text_box "DESIGN NOTES:\nWe are using 2 USB communication lines:\nUSB OTG FS (Full-speed) = 12Mbps (internal USB PHY in STM32)\nUSB OTG HG (High-speed) = 480Mbps (needs an external USB PHY)\n\nDFU_USB-A (Bootloader port) → OTG_USB_FS\nVCP_USB-A (Virtual COM port) → OTG_USB_HS\n\nWe will actually be using normal USB and not USB OTG, because the PC will always be configured to be the host, and the STM32 to be the device. Meaning the PC will push VBUS to the STM32.\n"
		(exclude_from_sim no)
		(at 184.785 13.335 0)
		(size 98.425 40.005)
		(margins 1.8 1.8 1.8 1.8)
		(stroke
			(width 0.6)
			(type solid)
