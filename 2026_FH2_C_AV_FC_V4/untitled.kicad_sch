				(size 2 2)
				(color 0 0 0 1)
			)
			(justify left top)
		)
		(uuid "7ffb2355-a878-4db3-b801-e4f4438329f6")
	)
	(text_box "DESIGN NOTES:\nCeramic patch antennas are passif, so LNA_EN disabled by pulling it low.\n"
