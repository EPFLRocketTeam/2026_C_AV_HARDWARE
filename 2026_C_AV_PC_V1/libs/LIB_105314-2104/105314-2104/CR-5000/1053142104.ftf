(ftf
  (header
    (version 2.0)
    (unit DBUNIT)
  )
  (TechnologyContainer
    (technology SamacSys_Footprint
      (footprintLayer
        (layer Top (type Conductive))
        (layer Inner (type Conductive))
        (layer Bottom (type Conductive))
        (layer Silk-Top (type Symbolmark))
        (layer Silk-Bottom (type Symbolmark))
        (layer Resist-Top (type Solderresist))
        (layer Resist-Bottom (type Solderresist))
        (layer MetalMask-Top (type Metalmask))
        (layer MetalMask-Bottom (type Metalmask))
        (layer CompArea-Top (type Comparea))
        (layer CompArea-Bottom (type Comparea))
        (layer Assembly-Top (type Undefined))
        (layer Assembly-Bottom (type Undefined))
        (layer Hole (type Hole))
      )
    )
  )
  (footprintContainer
    (commonParameters
      (dimensionParameters
        (arrowLength 100000)
        (arrowAngle 15.000000)
        (dotDiameter 100000)
        (textFrameOffset 100000)
        (arrowOffset 100000)
        (dimAssistOffset 100000)
        (dimLineWidth 10000)
        (drawTextFrame NO)
        (textFrameRange ALL)
        (textClip NO)
        (standard JIS)
      )
    )
    (padstackGroups
      (padstackGroup default)
    )
    (pads
      (pad c187.5
        (photo FLASH)
        (panelUse NO)
        (geometry
          (circle 93750
            (pt 0 0)
          )
        )
      )
      (pad c87.5
        (photo FLASH)
        (panelUse NO)
        (geometry
          (circle 43750
            (pt 0 0)
          )
        )
      )
    ); End of pads
    (padstacks
      (padstack c187.5h125
        (type PLATED)
        (throughMode THROUGH)
        (panelUse NO)
        (Hole (footLayer Hole)
          (geometry
            (circle 62500
              (pt 0 0)
            )
          )
        )
        (padSet (footLayer Top)
          (connect (pad c187.5))
          (noconnect (pad c187.5))
        )
        (padSet (footLayer Resist-Top)
          (connect (pad c187.5))
          (noconnect (pad c187.5))
        )
        (padSet (footLayer Resist-Bottom)
          (connect (pad c187.5))
          (noconnect (pad c187.5))
        )
        (padSet (footLayer Inner)
          (clearance (pad c187.5))
          (connect (pad c187.5))
          (noconnect (pad c187.5))
        )
        (padSet (footLayer Bottom)
          (connect (pad c187.5))
          (noconnect (pad c187.5))
        )
      )
      (padstack c87.5h175
        (type PLATED)
        (throughMode THROUGH)
        (panelUse NO)
        (Hole (footLayer Hole)
          (geometry
            (circle 87500
              (pt 0 0)
            )
          )
        )
        (padSet (footLayer Top)
          (connect (pad c87.5))
          (noconnect (pad c87.5))
        )
        (padSet (footLayer Resist-Top)
          (connect (pad c87.5))
          (noconnect (pad c87.5))
        )
        (padSet (footLayer Resist-Bottom)
          (connect (pad c87.5))
          (noconnect (pad c87.5))
        )
        (padSet (footLayer Inner)
          (clearance (pad c87.5))
          (connect (pad c87.5))
          (noconnect (pad c87.5))
        )
        (padSet (footLayer Bottom)
          (connect (pad c87.5))
          (noconnect (pad c87.5))
        )
      )
    ); End of padstacks
    (footprints
      (footprint "1053142104"
        (polarity YES)
        (panelUse NO)
        (heelprint
          (layout
            (layer (footLayer Assembly-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt -422000 216000
                        (width 20000)
                      )
                      (pt 172000 216000
                        (width 20000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Assembly-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt 172000 216000
                        (width 20000)
                      )
                      (pt 172000 -968000
                        (width 20000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Assembly-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt 172000 -968000
                        (width 20000)
                      )
                      (pt -422000 -968000
                        (width 20000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Assembly-Top)
