                    (vertex
                      (arc CCW
                        (r 5000)
                        (begin
                          (pt -190000 -360000
                            (width 10000)
                          )
                        )
                        (center 0 -1073741824)
                        (end
                          (pt -190000 -370000
                            (width 10000)
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Silk-Top)
              (line
