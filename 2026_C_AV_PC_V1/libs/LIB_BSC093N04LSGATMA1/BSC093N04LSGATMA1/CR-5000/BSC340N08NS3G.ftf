                        (r 5000)
                        (begin
                          (pt -190000 -370000
                            (width 10000)
                          )
                        )
                        (center 0 1073741824)
                        (end
                          (pt -190000 -360000
                            (width 10000)
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
           ); End of layout
         ); End of heelprint
         (toeprint
